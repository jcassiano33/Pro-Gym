# Copie este arquivo para ".env" e ajuste os valores.
# Em desenvolvimento nenhuma variável é obrigatória.

# Gere uma chave nova para produção:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# E-mail (recuperação de senha). Sem EMAIL_HOST os e-mails aparecem no terminal.
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Pro Gym <contato@exemplo.com>
